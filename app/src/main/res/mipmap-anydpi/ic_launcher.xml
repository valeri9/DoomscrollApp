<?xml version="1.0" encoding="utf-8"?>
<!--
  No <monochrome> here on purpose: in this unversioned folder it makes the resource fail to link
  at all. The themed-icon variant lives in mipmap-anydpi-v33, where Android first uses it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MonochromeLauncherIcon">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
