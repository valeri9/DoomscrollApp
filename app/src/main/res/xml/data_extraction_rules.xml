<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup="false" only covers Android 11 and below; from 12 on, this is what keeps the
  doomscroll log and settings out of cloud backups and phone-to-phone transfers. The data is
  personal and meaningless on another device's rules and app versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
